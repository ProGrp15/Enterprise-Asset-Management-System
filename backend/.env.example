# Copy to your process environment or a local .env file. Never commit real values.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/assetflow_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me
APP_JWT_SECRET=generate-a-long-random-secret
APP_SUPERADMIN_PASSWORD=change-me-before-first-start
EUREKA_URL=http://localhost:8761/eureka/

# SMTP (required for actual password-reset and notification delivery)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=notifications@example.com
MAIL_PASSWORD=app-password-or-smtp-secret
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
