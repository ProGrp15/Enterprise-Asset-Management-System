{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "platformRoute": {
        "ClusterId": "companyCluster",
        "Match": {
          "Path": "/api/platform/{**catch-all}"
        }
      },
      "departmentRoute": {
        "ClusterId": "companyCluster",
        "Match": {
          "Path": "/api/department/{**catch-all}"
        }
      },
      "employeeRoute": {
        "ClusterId": "companyCluster",
        "Match": {
          "Path": "/api/employee/{**catch-all}"
        }
      },
      "adminRoute": {
        "ClusterId": "companyCluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      },
      "locationRoute": {
        "ClusterId": "companyCluster",
        "Match": {
          "Path": "/api/location/{**catch-all}"
        }
      },
      "buildingRoute": {
        "ClusterId": "companyCluster",
        "Match": {
          "Path": "/api/building/{**catch-all}"
        }
      },
      "floorRoute": {
        "ClusterId": "companyCluster",
        "Match": {
          "Path": "/api/floor/{**catch-all}"
        }
      },
      "roomRoute": {
        "ClusterId": "companyCluster",
        "Match": {
          "Path": "/api/room/{**catch-all}"
        }
      },
      "assetRoute": {
        "ClusterId": "assetCluster",
        "Match": {
          "Path": "/api/asset/{**catch-all}"
        }
      },
      "categoryRoute": {
        "ClusterId": "assetCluster",
        "Match": {
          "Path": "/api/category/{**catch-all}"
        }
      },
      "vendorRoute": {
        "ClusterId": "assetCluster",
        "Match": {
          "Path": "/api/vendor/{**catch-all}"
        }
      },
      "maintenanceRoute": {
        "ClusterId": "assetCluster",
        "Match": {
          "Path": "/api/maintenance/{**catch-all}"
        }
      },
      "assetRequestRoute": {
        "ClusterId": "assetCluster",
        "Match": {
          "Path": "/api/asset-request/{**catch-all}"
        }
      },
      "assetAllocationRoute": {
        "ClusterId": "assetCluster",
        "Match": {
          "Path": "/api/asset-allocation/{**catch-all}"
        }
      },
      "emailRoute": {
        "ClusterId": "notificationCluster",
        "Match": {
          "Path": "/api/email/{**catch-all}"
        }
      },
      "notificationRoute": {
        "ClusterId": "notificationCluster",
        "Match": {
          "Path": "/api/notification/{**catch-all}"
        }
      },
      "auditRoute": {
        "ClusterId": "notificationCluster",
        "Match": {
          "Path": "/api/audit/{**catch-all}"
        }
      },
      "dashboardRoute": {
        "ClusterId": "notificationCluster",
        "Match": {
          "Path": "/api/dashboard/{**catch-all}"
        }
      },
      "reportRoute": {
        "ClusterId": "notificationCluster",
        "Match": {
          "Path": "/api/report/{**catch-all}"
        }
      },
      "aiRoute": {
        "ClusterId": "notificationCluster",
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "authCluster": {
        "Destinations": {
          "authDestination": {
            "Address": "http://authservice"
          }
        }
      },
      "companyCluster": {
        "Destinations": {
          "companyDestination": {
            "Address": "http://companyservice"
          }
        }
      },
      "assetCluster": {
        "Destinations": {
          "assetDestination": {
            "Address": "http://assetservice"
          }
        }
      },
      "notificationCluster": {
        "Destinations": {
          "notificationDestination": {
            "Address": "http://notificationservice"
          }
        }
      }
    }
  }
}
